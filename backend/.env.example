# Copy to backend/.env and edit. Never commit the real .env file.

ENVIRONMENT=development

# MongoDB Atlas connection string (see README "MongoDB configuration").
# Leave empty to run with a NON-persistent in-memory store (fine for a quick local demo).
MONGODB_URI=
MONGODB_DB=predictai

# Comma-separated list of frontend origins allowed to call the API (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example: CORS_ORIGINS=https://your-app.vercel.app

# Load the neural models at start-up. Set both to false on small servers (TensorFlow needs ~500 MB RAM);
# the N-gram model keeps working.
ENABLE_LSTM=true
ENABLE_TRANSFORMER=true

# Folder with vocab.json, ngram/ and lstm/ (default: ml_models/saved_models).
SAVED_MODELS_DIR=

# Per-IP limit for /predict and /complete (requests per minute, 0 = off)
RATE_LIMIT_PER_MINUTE=300
PREDICT_TIMEOUT_SECONDS=5
MAX_DOCUMENTS_PER_CLIENT=200
